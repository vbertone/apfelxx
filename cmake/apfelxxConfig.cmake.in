@PACKAGE_INIT@

set(apfelxx_WITH_YAML_CPP "@WITH_YAML_CPP@")
include(CMakeFindDependencyMacro)

if(NOT apfelxx_WITH_YAML_CPP STREQUAL "")
   find_dependency(yaml-cpp CONFIG)
endif()


# Include exported targets
include("${CMAKE_CURRENT_LIST_DIR}/apfelxxTargets.cmake")

# Check that targets exist and provide helpful error messages
if(NOT TARGET apfelxx::apfelxx)
    message(FATAL_ERROR "The imported target 'apfelxx::apfelxx' was not found. Please make sure the apfelxx installation is correct.")
endif()

# Provide legacy variables for backward compatibility
set(apfelxx_LIBRARIES apfelxx::apfelxx)
set(apfelxx_INCLUDE_DIRS "@PACKAGE_INCLUDE_INSTALL_DIR@")
