      RowBox[{
       RowBox[{"FP3NSmS", "[", "1", "]"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{"N", "-", "1"}], ")"}]}], "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "11"}], ")"}]}], ",", "1"}], "}"}]}], "]"}], "+", 
   RowBox[{"FP3NSmL", "[", "1", "]"}]}]}], "\[IndentingNewLine]", 
