Cell[BoxData[{
 RowBox[{
  RowBox[{"MomNSp", "[", "N_", "]"}], ":=", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FP3NSpR", "[", "x", "]"}], 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"N", "-", "1"}], ")"}]}]}], "+", 
      RowBox[{
       RowBox[{"FP3NSpS", "[", "1", "]"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{"N", "-", "1"}], ")"}]}], "-", "1"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "11"}], ")"}]}], ",", "1"}], "}"}]}], "]"}], "+", 
   RowBox[{"FP3NSpL", "[", "1", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MomNSm", "[", "N_", "]"}], ":=", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
