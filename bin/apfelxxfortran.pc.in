prefix=@prefix@
exec_prefix=@exec_prefix@
includedir=@includedir@
libdir=@libdir@

Name: apfelxxfortran
Description: Fortran wrapper for APFEL++, mirroring the old Fortran-native APFEL interface
Version: @apfelxx_VERSION@
Requires: apfelxx
Cflags: -I${includedir}/apfel/fortran
Libs: -L${libdir} -lapfelxxfortran
